# Server port (optional, defaults to 4000)
# PORT=4000

# Live-feed camera selection for the /live route.
# Leave empty (or omit entirely) to use the system's default camera.
# Set to a substring of the device name to force a specific input —
# matched case-insensitively against the camera's label.
# Examples:
#   LIVE_CAMERA_LABEL=NDI Video
#   LIVE_CAMERA_LABEL=Elgato Cam Link
LIVE_CAMERA_LABEL=
